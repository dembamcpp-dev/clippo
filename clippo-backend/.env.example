# ─── Serveur ───────────────────────────────────────────────
PORT=3000
FRONTEND_URL=https://ton-domaine.com
# Secret utilisé pour signer les sessions JWT (génère une chaîne aléatoire longue)
JWT_SECRET=change_moi_avec_une_chaine_aleatoire_longue

# ─── Google Sign-In ────────────────────────────────────────
# Google Cloud Console → APIs & Services → Identifiants
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# ─── Wave (paiement) ───────────────────────────────────────
# https://dashboard.wave.com → Développeurs → Clés API
WAVE_API_KEY=wave_sn_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WAVE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Orange Money (paiement) ───────────────────────────────
# https://developer.orange.com → ton app Web Payment
ORANGE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
ORANGE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ORANGE_MERCHANT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# URL à laquelle Orange notifie le paiement (doit être accessible publiquement)
ORANGE_NOTIF_URL=https://ton-domaine.com/api/payments/orange/notify
